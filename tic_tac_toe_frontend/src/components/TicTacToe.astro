---
/**
 * TicTacToe.astro
 * Modern, minimalistic, responsive Tic Tac Toe component.
 * Features:
 * - Start new game
 * - Two player mode
 * - Play against basic AI
 * - Score tracking (session-based via localStorage)
 * - Responsive design
 * - Game reset option
 */
const COLORS = {
  primary: '#3498db',
  secondary: '#2ecc71',
  accent: '#e67e22',
};
---

<section class="app">
  <header class="topbar">
    <div class="branding">
      <div class="logo-circle">TTT</div>
      <div class="title">
        <h1>Tic Tac Toe</h1>
        <p class="subtitle">Play vs Friend or AI</p>
      </div>
    </div>

    <div class="mode-controls">
      <label class="mode-label" for="mode-select">Mode</label>
      <div class="select-wrap">
        <select id="mode-select" aria-label="Game mode">
          <option value="pvp">Two Players</option>
          <option value="ai">Vs AI</option>
        </select>
      </div>
      <button id="new-game" class="btn primary" aria-label="Start new game">New Game</button>
    </div>
  </header>

  <div class="content">
    <aside class="sidebar">
      <div class="scoreboard card" role="group" aria-label="Scoreboard">
        <h2>Score</h2>
        <div class="scores">
          <div class="score-item">
            <span class="label">X</span>
            <span id="score-x" class="value">0</span>
          </div>
          <div class="score-item">
            <span class="label">O</span>
            <span id="score-o" class="value">0</span>
          </div>
          <div class="score-item">
            <span class="label">Draw</span>
            <span id="score-draw" class="value">0</span>
          </div>
        </div>
        <button id="reset-score" class="btn ghost small" aria-label="Reset scores">Reset Scores</button>
      </div>

      <div class="status card">
        <h2>Status</h2>
        <p id="status-text">Player X's turn</p>
      </div>
    </aside>

    <main class="board-wrap">
      <div id="board" class="board" role="grid" aria-label="Tic Tac Toe board">
        <button class="cell" data-index="0" role="gridcell" aria-label="Cell 1"></button>
        <button class="cell" data-index="1" role="gridcell" aria-label="Cell 2"></button>
        <button class="cell" data-index="2" role="gridcell" aria-label="Cell 3"></button>
        <button class="cell" data-index="3" role="gridcell" aria-label="Cell 4"></button>
        <button class="cell" data-index="4" role="gridcell" aria-label="Cell 5"></button>
        <button class="cell" data-index="5" role="gridcell" aria-label="Cell 6"></button>
        <button class="cell" data-index="6" role="gridcell" aria-label="Cell 7"></button>
        <button class="cell" data-index="7" role="gridcell" aria-label="Cell 8"></button>
        <button class="cell" data-index="8" role="gridcell" aria-label="Cell 9"></button>
      </div>

      <div class="board-actions">
        <button id="reset-board" class="btn secondary" aria-label="Reset current game">Reset Board</button>
      </div>
    </main>
  </div>

  <footer class="footer">
    <div class="footer-left">
      <span class="dot" style={`--dot: ${COLORS.primary}`}></span>
      <span>Modern • Minimal • Responsive</span>
    </div>
    <div class="footer-actions">
      <button id="clear-all" class="btn danger ghost" aria-label="Clear session & scores">Clear Session</button>
    </div>
  </footer>
</section>

<style>
  :root {
    --primary: ${COLORS.primary};
    --secondary: ${COLORS.secondary};
    --accent: ${COLORS.accent};
    --bg: var(--bg-color, #ffffff);
    --text: var(--text-color, #111827);
    --muted: var(--text-secondary, #6b7280);
    --card: var(--card-bg, #ffffff);
    --card-hover: var(--card-hover-bg, rgba(0,0,0,0.02));
    --border: var(--border-color, rgba(0,0,0,0.1));
    --shadow: var(--shadow-color, rgba(0,0,0,0.08));
    --shadow-strong: var(--shadow-hover-color, rgba(0,0,0,0.12));
    --radius: 16px;
    --radius-sm: 12px;
    --gap: 16px;
  }

  .app {
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px 16px;
    display: grid;
    gap: 16px;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px var(--shadow);
  }

  .branding {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .logo-circle {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: white;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    box-shadow: 0 6px 14px rgba(0,0,0,0.15);
  }

  .title h1 {
    margin: 0;
    font-size: 20px;
  }
  .subtitle {
    margin: 2px 0 0;
    color: var(--muted);
    font-size: 13px;
  }

  .mode-controls {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .mode-label {
    color: var(--muted);
    font-size: 13px;
  }

  .select-wrap {
    position: relative;
  }

  select {
    appearance: none;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    padding: 10px 32px 10px 12px;
    border-radius: 10px;
    font-size: 14px;
    transition: border-color .2s, box-shadow .2s, background .2s;
    outline: none;
  }
  select:hover {
    background: var(--card-hover);
  }
  select:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--primary), transparent 80%);
  }

  .content {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 16px;
  }

  .sidebar {
    display: grid;
    align-content: start;
    gap: 16px;
  }

  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    box-shadow: 0 8px 24px var(--shadow);
  }

  .scoreboard h2, .status h2 {
    margin: 0 0 12px;
    font-size: 16px;
  }

  .scores {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 10px;
  }

  .score-item {
    background: var(--card-hover);
    border: 1px dashed var(--border);
    border-radius: 10px;
    padding: 10px 8px;
    text-align: center;
  }
  .score-item .label {
    display: block;
    font-size: 12px;
    color: var(--muted);
  }
  .score-item .value {
    display: block;
    font-weight: 700;
    font-size: 18px;
    margin-top: 4px;
  }

  .status p {
    margin: 0;
    color: var(--muted);
  }

  .board-wrap {
    display: grid;
    gap: 12px;
    justify-items: center;
  }

  .board {
    width: min(100%, 500px);
    aspect-ratio: 1 / 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    padding: 12px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 12px 28px var(--shadow);
  }

  .cell {
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg);
    color: var(--text);
    display: grid;
    place-items: center;
    font-size: clamp(32px, 8vw, 60px);
    font-weight: 800;
    letter-spacing: 1px;
    cursor: pointer;
    transition: transform .06s ease, background .2s ease, box-shadow .2s ease;
    box-shadow: 0 4px 10px var(--shadow);
    user-select: none;
  }
  .cell:hover {
    background: var(--card-hover);
    transform: translateY(-1px);
    box-shadow: 0 8px 16px var(--shadow-strong);
  }
  .cell:disabled {
    cursor: not-allowed;
    opacity: 0.7;
    transform: none;
  }
  .cell.win {
    background: color-mix(in oklab, var(--secondary), transparent 80%);
    border-color: var(--secondary);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--secondary), transparent 70%);
  }

  .board-actions {
    display: flex;
    gap: 10px;
  }

  .btn {
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    padding: 10px 14px;
    border-radius: 12px;
    font-size: 14px;
    cursor: pointer;
    transition: background .2s, box-shadow .2s, border-color .2s, transform .04s;
    box-shadow: 0 6px 14px var(--shadow);
  }
  .btn:hover { background: var(--card-hover); }
  .btn:active { transform: translateY(1px); }

  .btn.primary {
    background: linear-gradient(135deg, var(--primary), color-mix(in oklab, var(--primary), white 20%));
    color: white;
    border-color: transparent;
  }
  .btn.primary:hover {
    box-shadow: 0 8px 18px color-mix(in oklab, var(--primary), transparent 70%);
  }

  .btn.secondary {
    background: linear-gradient(135deg, var(--secondary), color-mix(in oklab, var(--secondary), white 20%));
    color: white;
    border-color: transparent;
  }

  .btn.danger {
    background: linear-gradient(135deg, var(--accent), color-mix(in oklab, var(--accent), white 20%));
    color: white;
    border-color: transparent;
  }

  .btn.ghost {
    background: transparent;
    border-color: var(--border);
    color: var(--text);
  }

  .btn.small {
    padding: 8px 10px;
    font-size: 12px;
  }

  .footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    background: var(--card);
    border-radius: var(--radius);
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 13px;
  }
  .dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--dot, var(--primary));
    display: inline-block;
  }

  @media (max-width: 980px) {
    .content {
      grid-template-columns: 1fr;
    }
    .sidebar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .topbar { flex-direction: column; align-items: stretch; }
    .mode-controls { justify-content: space-between; }
    .sidebar { grid-template-columns: 1fr; }
    .board { gap: 6px; padding: 10px; }
  }
</style>

<script>
  // PUBLIC_INTERFACE
  /**
   * Initialize the Tic Tac Toe game component.
   * Handles mode switching (PvP or AI), board interactions, win detection,
   * basic AI moves, session-based score keeping (localStorage), and resets.
   */
  function initTicTacToe() {
    const boardEl = document.getElementById('board');
    const statusText = document.getElementById('status-text');
    const modeSelect = document.getElementById('mode-select');
    const newGameBtn = document.getElementById('new-game');
    const resetBoardBtn = document.getElementById('reset-board');
    const resetScoreBtn = document.getElementById('reset-score');
    const clearAllBtn = document.getElementById('clear-all');
    const scoreXEl = document.getElementById('score-x');
    const scoreOEl = document.getElementById('score-o');
    const scoreDrawEl = document.getElementById('score-draw');

    // Session storage keys
    const LS_KEYS = {
      SCORE: 'ttt_scores_v1',
      MODE: 'ttt_mode_v1',
    };

    // Game state
    let board = Array(9).fill(null); // 'X' | 'O' | null
    let current = 'X';
    let mode = 'pvp'; // 'pvp' | 'ai'
    let active = true;

    // Load persisted mode and score
    function loadMode() {
      const saved = localStorage.getItem(LS_KEYS.MODE);
      if (saved === 'ai' || saved === 'pvp') {
        mode = saved;
      }
      modeSelect.value = mode;
    }

    function loadScores() {
      try {
        const raw = localStorage.getItem(LS_KEYS.SCORE);
        if (!raw) return { X: 0, O: 0, D: 0 };
        const parsed = JSON.parse(raw);
        return {
          X: Number(parsed.X) || 0,
          O: Number(parsed.O) || 0,
          D: Number(parsed.D) || 0,
        };
      } catch {
        return { X: 0, O: 0, D: 0 };
      }
    }

    let scores = loadScores();
    updateScoreUI();

    function saveScores() {
      localStorage.setItem(LS_KEYS.SCORE, JSON.stringify(scores));
    }

    function updateScoreUI() {
      scoreXEl.textContent = String(scores.X);
      scoreOEl.textContent = String(scores.O);
      scoreDrawEl.textContent = String(scores.D);
    }

    function saveMode() {
      localStorage.setItem(LS_KEYS.MODE, mode);
    }

    function setStatus(text) {
      statusText.textContent = text;
    }

    function resetBoard() {
      board = Array(9).fill(null);
      current = 'X';
      active = true;
      for (const cell of boardEl.querySelectorAll('.cell')) {
        cell.textContent = '';
        cell.disabled = false;
        cell.classList.remove('win');
      }
      setStatus("Player X's turn");
    }

    function resetScores() {
      scores = { X: 0, O: 0, D: 0 };
      saveScores();
      updateScoreUI();
    }

    function clearAll() {
      localStorage.removeItem(LS_KEYS.SCORE);
      localStorage.removeItem(LS_KEYS.MODE);
      resetScores();
      mode = 'pvp';
      modeSelect.value = mode;
      saveMode();
      resetBoard();
    }

    // Win detection
    const LINES = [
      [0,1,2],[3,4,5],[6,7,8],
      [0,3,6],[1,4,7],[2,5,8],
      [0,4,8],[2,4,6]
    ];

    function findWinner(b) {
      for (const [a, c, d] of LINES) {
        if (b[a] && b[a] === b[c] && b[a] === b[d]) {
          return { winner: b[a], line: [a,c,d] };
        }
      }
      if (b.every(Boolean)) return { winner: 'D', line: [] }; // Draw
      return { winner: null, line: [] };
    }

    // Basic AI:
    // 1) Win if possible
    // 2) Block opponent
    // 3) Take center
    // 4) Take a corner
    // 5) Take any free side
    function aiMove() {
      const ai = 'O';
      const human = 'X';

      // Helper to attempt a move that completes a line for 'symbol'
      function winningIndexFor(symbol) {
        for (const [a,b,c] of LINES) {
          const line = [a,b,c];
          const marks = line.map(i => board[i]);
          const countSymbol = marks.filter(m => m === symbol).length;
          const countEmpty = marks.filter(m => m === null).length;
          if (countSymbol === 2 && countEmpty === 1) {
            const emptyIdx = line.find(i => board[i] === null);
            return emptyIdx;
          }
        }
        return null;
      }

      // 1) Win
      let idx = winningIndexFor(ai);
      if (idx !== null) return idx;
      // 2) Block
      idx = winningIndexFor(human);
      if (idx !== null) return idx;
      // 3) Center
      if (board[4] === null) return 4;
      // 4) Corner
      const corners = [0,2,6,8].filter(i => board[i] === null);
      if (corners.length) return corners[Math.floor(Math.random() * corners.length)];
      // 5) Side
      const sides = [1,3,5,7].filter(i => board[i] === null);
      if (sides.length) return sides[Math.floor(Math.random() * sides.length)];
      return null;
    }

    function applyWinStyle(line) {
      for (const i of line) {
        const cell = boardEl.querySelector(`.cell[data-index="${i}"]`);
        if (cell) cell.classList.add('win');
      }
    }

    function lockBoard() {
      for (const cell of boardEl.querySelectorAll('.cell')) {
        cell.disabled = true;
      }
    }

    function tryFinishGame() {
      const { winner, line } = findWinner(board);
      if (winner === 'X' || winner === 'O') {
        setStatus(`Player ${winner} wins!`);
        scores[winner] += 1;
        saveScores();
        updateScoreUI();
        applyWinStyle(line);
        active = false;
        lockBoard();
        return true;
      } else if (winner === 'D') {
        setStatus('Draw!');
        scores.D += 1;
        saveScores();
        updateScoreUI();
        active = false;
        lockBoard();
        return true;
      }
      return false;
    }

    function handleCellClick(e) {
      const btn = e.currentTarget;
      const idx = Number(btn.dataset.index);
      if (!active || board[idx]) return;

      board[idx] = current;
      btn.textContent = current;
      btn.disabled = true;

      if (tryFinishGame()) return;

      // Switch turns
      current = current === 'X' ? 'O' : 'X';
      setStatus(`Player ${current}'s turn`);

      // If AI mode and it's AI's turn
      if (mode === 'ai' && current === 'O' && active) {
        setTimeout(() => {
          const move = aiMove();
          if (move !== null) {
            const aiBtn = boardEl.querySelector(`.cell[data-index="${move}"]`);
            board[move] = 'O';
            if (aiBtn) {
              aiBtn.textContent = 'O';
              aiBtn.disabled = true;
            }
            if (tryFinishGame()) return;
            current = 'X';
            setStatus(`Player ${current}'s turn`);
          }
        }, 200);
      }
    }

    // Wire events
    boardEl.querySelectorAll('.cell').forEach((cell) => {
      cell.addEventListener('click', handleCellClick);
    });

    newGameBtn.addEventListener('click', () => {
      resetBoard();
      // If mode is AI and AI should start randomly? Keep human X for simplicity.
    });

    resetBoardBtn.addEventListener('click', resetBoard);
    resetScoreBtn.addEventListener('click', resetScores);
    clearAllBtn.addEventListener('click', clearAll);

    modeSelect.addEventListener('change', (e) => {
      mode = e.target.value === 'ai' ? 'ai' : 'pvp';
      saveMode();
      resetBoard();
    });

    // Initialize from storage
    loadMode();
    resetBoard();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTicTacToe);
  } else {
    initTicTacToe();
  }
</script>
